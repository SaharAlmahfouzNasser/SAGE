<edge source="Prostate-specific antigen" target="prostatic epithelium">
  <data key="d2">0.9</data>
  <data key="d3">expressed_in</data>
  <data key="d4">is serine protease produced at high concentrations by normal and malignant prostatic epithelium</data>
  <data key="d5">Prostate specific antigen (PSA) is serine protease produced at high concentrations by normal and malignant prostatic epithelium.</data>
  <data key="d6">expressed_in</data>
</edge>
<edge source="Prostate-specific antigen" target="prostate cancer">
  <data key="d2">15.200000000000001</data>
  <data key="d3">biomarker_for</data>
  <data key="d4">is a sensitive serum marker for prostate cancer</data>
  <data key="d5">Thus PSA is a sensitive serum marker for prostate cancer but its specificity is limited by a high frequency of falsely elevated values in men with benign prostatic hyperplasia (BPH).</data>
  <data key="d6">biomarker_for</data>
</edge>
<edge source="Prostate-specific antigen" target="threshold for PSA progression">
  <data key="d2">0.9</data>
  <data key="d3">measured_by</data>
  <data key="d4">threshold for PSA progression, a 25% increase from baseline</data>
  <data key="d5">threshold for PSA progression, a 25% increase from baseline (accompanied by an absolute increase of ≥ 2 ng/mL above the nadir)</data>
  <data key="d6">measured_by</data>
</edge>
<edge source="Prostate-specific antigen" target="threshold for PSA response">
  <data key="d2">0.9</data>
  <data key="d3">measured_by</data>
  <data key="d4">threshold for PSA response, a 50% decrease from baseline</data>
  <data key="d5">threshold for PSA response, a 50% decrease from baseline</data>
  <data key="d6">measured_by</data>
</edge>
<edge source="Prostate-specific antigen" target="prostate cancer screening">
  <data key="d2">0.8</data>
  <data key="d3">measured_by</data>
  <data key="d4">baseline prostate-specific antigen and digital rectal exam by experienced providers at age 40 years</data>
  <data key="d5">we propose a practical approach to prostate cancer screening for men with a germline mutation in a known/suspected moderate to high-penetrance cancer predisposition gene (eg, BRCA1/2), and/or men with a first- or second-degree relative with metastatic prostate cancer (regardless of genetic testing): baseline prostate-specific antigen and digital rectal exam by experienced providers at age 40 years.</data>
  <data key="d6">measured_by</data>
</edge>
<edge source="Prostate-specific antigen" target="digital rectal examination">
  <data key="d2">0.7</data>
  <data key="d3">measured_by</data>
  <data key="d4">serum prostate specific antigen (PSA) determination</data>
  <data key="d5">we recommend digital rectal examination (DRE) and, at least in high-risk patients, serum prostate specific antigen (PSA) determination.</data>
  <data key="d6">measured_by</data>
</edge>
<edge source="Prostate-specific antigen" target="sensitivity">
  <data key="d2">0.8</data>
  <data key="d3">other</data>
  <data key="d4">has poor sensitivity to determine the presence of prostate cancer</data>
  <data key="d5">studies have suggested that PSA alone has poor sensitivity to determine the presence of prostate cancer for any risk stratification category.</data>
  <data key="d6">other</data>
</edge>
<edge source="Prostate-specific antigen" target="osteoblast growth factors">
  <data key="d2">0.9</data>
  <data key="d3">activates</data>
  <data key="d4">not only can cleave PTHrP to release osteoblastic PTHrP fragments, it also activates osteoblast growth factors such as TGF-β</data>
  <data key="d5">PSA not only can cleave PTHrP to release osteoblastic PTHrP fragments, it also activates osteoblast growth factors such as TGF-β.</data>
  <data key="d6">activates</data>
</edge>
